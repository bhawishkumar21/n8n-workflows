      "parameters": {
        "jsCode": "const src = $input.first().json;\nconst body = src.body ?? src;\nconst clean = (v) => String(v ?? '')\n  .replace(/<[^>]*>/g, '')\n  .replace(/[\\u0000-\\u001F\\u007F]/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst order_id = clean(body.order_id);\nif (!order_id) throw new Error('order_id is required');\n\nconst customer_email = clean(body.customer_email).toLowerCase();\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(customer_email)) throw new Error('A valid customer_email is required');\n\nlet rating = Number(body.rating_stars);\nif (!Number.isFinite(rating)) throw new Error('rating_stars must be a number between 1 and 5');\nrating = Math.min(5, Math.max(1, Math.round(rating)));\n\nconst items = Array.isArray(body.items_ordered) ? body.items_ordered.map(clean).filter(Boolean) : [];\n\nreturn [{\n  json: {\n    order_id,\n    customer_name: clean(body.customer_name) || 'Valued Customer',\n    customer_email,\n    customer_phone: clean(body.customer_phone),\n    rating_stars: rating,\n    feedback_text: clean(body.feedback_text).slice(0, 2000) || '(no comment provided)',\n    items_ordered: items,\n    received_at: new Date().toISOString()\n  }\n}];"
      },
