    {
      "parameters": {
        "jsCode": "const input = $('Validate & Format Input').first().json;\nconst res = $input.first().json;\n\nlet ai = {};\ntry {\n  const raw = res.choices?.[0]?.message?.content;\n  ai = typeof raw === 'string' ? JSON.parse(raw) : {};\n} catch (e) { ai = {}; }\n\nconst CATS = ['VERY_POSITIVE', 'POSITIVE', 'NEUTRAL', 'NEGATIVE', 'CRITICAL'];\nconst ISSUES = ['FOOD_QUALITY', 'DELIVERY_SPEED', 'SERVICE', 'PRICING', 'NONE'];\nconst LABELS = { FOOD_QUALITY: 'the food quality', DELIVERY_SPEED: 'the delivery speed', SERVICE: 'our service', PRICING: 'the pricing', NONE: 'your experience' };\n\n// Fallback if the AI call failed: derive score from stars\nlet score = Number(ai.sentiment_score);\nconst ai_fallback = !Number.isFinite(score);\nif (ai_fallback) score = ((input.rating_stars - 3) / 2) * 0.8;\nscore = Math.max(-1, Math.min(1, Math.round(score * 100) / 100));\n\nconst category = CATS.includes(ai.sentiment_category) ? ai.sentiment_category\n  : score >= 0.6 ? 'VERY_POSITIVE' : score >= 0.2 ? 'POSITIVE' : score > -0.2 ? 'NEUTRAL' : score > -0.6 ? 'NEGATIVE' : 'CRITICAL';\nconst issue_type = ISSUES.includes(ai.issue_type) ? ai.issue_type : 'NONE';\n\nconst should_issue_discount = input.rating_stars <= 3 || score < 0;\nconst positive = input.rating_stars >= 4 && score > 0.3;\nconst branch = should_issue_discount ? 'NEGATIVE' : positive ? 'POSITIVE' : 'NEUTRAL';\n\nconst chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\nlet suffix = '';\nfor (let i = 0; i < 5; i++) suffix += chars[Math.floor(Math.random() * chars.length)];\nconst prefix = branch === 'NEGATIVE' ? 'SORRY20' : branch === 'POSITIVE' ? 'THANKYOU10' : null;\n\nreturn [{\n  json: {\n    ...input,\n    sentiment_score: score,\n    sentiment_category: category,\n    issue_type,\n    issue_label: LABELS[issue_type],\n    should_issue_discount,\n    summary: String(ai.summary || `${input.rating_stars}-star feedback`).slice(0, 300),\n    voucher_code: prefix ? `${prefix}-${suffix}` : '',\n    voucher_expires_at: new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString(),\n    branch,\n    status: branch === 'NEGATIVE' ? 'needs_followup' : 'processed',\n    ai_fallback\n  }\n}];"
      },
