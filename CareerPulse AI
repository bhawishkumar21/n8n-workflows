        "jsCode": "const first = $input.first().json;\nconst raw = first.message?.content || first.content || first.text || JSON.stringify(first);\nconst parentData = $(\"Code in JavaScript\").first().json;\n\nlet cleaned = raw.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(cleaned);\n} catch (e) {\n  data = { match_score: 'N/A', missing_keywords: [], tailored_bullets: [raw], summary: '' };\n}\n\nconst keywordsHtml = (data.missing_keywords || []).map(k => `<span style=\"display:inline-block;background:#fee2e2;color:#991b1b;padding:4px 10px;border-radius:12px;font-size:12px;margin:3px\">${k}</span>`).join('');\nconst bulletsHtml = (data.tailored_bullets || []).map(b => `<li style=\"margin-bottom:8px;line-height:1.5\">${b}</li>`).join('');\n\nconst html = `\n<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;color:#1f2937\">\n  <div style=\"background:linear-gradient(135deg,#4f46e5,#06b6d4);padding:24px;border-radius:12px 12px 0 0;text-align:center\">\n    <h1 style=\"color:#fff;margin:0;font-size:20px\">Nexium AI — CV Tailoring Report</h1>\n  </div>\n  <div style=\"border:1px solid #e5e7eb;border-top:none;padding:24px;border-radius:0 0 12px 12px\">\n    <p>Hi <b>${parentData.candidate_name}</b>,</p>\n    <p>Here's your ATS optimization report against the target job description.</p>\n\n    <div style=\"background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:16px;text-align:center;margin:20px 0\">\n      <p style=\"margin:0;font-size:13px;color:#166534\">ATS MATCH SCORE</p>\n      <p style=\"margin:4px 0 0;font-size:32px;font-weight:bold;color:#15803d\">${data.match_score}%</p>\n    </div>\n\n    <h3 style=\"color:#4f46e5;border-bottom:2px solid #e0e7ff;padding-bottom:6px\">Missing Keywords</h3>\n    <div style=\"margin-bottom:20px\">${keywordsHtml || '<i>None found — great match!</i>'}</div>\n\n    <h3 style=\"color:#4f46e5;border-bottom:2px solid #e0e7ff;padding-bottom:6px\">Tailored Bullet Points</h3>\n    <ul style=\"padding-left:20px\">${bulletsHtml}</ul>\n\n    <h3 style=\"color:#4f46e5;border-bottom:2px solid #e0e7ff;padding-bottom:6px\">Summary</h3>\n    <p style=\"line-height:1.6\">${data.summary || ''}</p>\n\n    <p style=\"margin-top:24px;font-size:12px;color:#9ca3af\">— Nexium AI Career Orchestrator</p>\n  </div>\n</div>`;\n\nreturn [\n  {\n    json: {\n      candidate_name: parentData.candidate_name,\n      candidate_email: parentData.candidate_email,\n      subject: \"Nexium AI - Your ATS Optimization & CV Tailoring Report\",\n      report_body: html,\n      action_path: parentData.action_path\n    }\n  }\n];"
